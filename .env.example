# Skopiuj do .env i dostosuj przed uzyciem uslug "hardware" (flash/monitor/shell)
# z docker-compose.yml.
#
# Port szeregowy plytki ESP32 widziany z hosta:
#   Linux:            /dev/ttyUSB0 (lub /dev/ttyACM0)
#   macOS:             UWAGA - Docker Desktop na macOS NIE przekazuje portow
#                       USB/szeregowych do kontenerow. Flashowanie/monitor
#                       trzeba wtedy uruchomic lokalnym ESP-IDF, nie z Dockera.
#                       Docker mozna nadal uzywac do samego budowania.
#   Windows (WSL2):    wymaga przekazania portu do WSL2 przez usbipd-win,
#                       potem zwykle /dev/ttyUSB0 wewnatrz WSL2.
ESP32_PORT=/dev/ttyUSB0
